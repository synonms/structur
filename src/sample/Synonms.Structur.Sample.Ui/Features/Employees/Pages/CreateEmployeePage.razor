@page "/employees/create"

<PageTitle>Create Employee</PageTitle>

<CarbonBlazorPane Title="Create Employee">
    <EmployeeForm Model="_model" OperationType="OperationType.Create" ValidSubmitCallback="OnValidSubmitAsync"></EmployeeForm>
</CarbonBlazorPane>

@code {
    private readonly EmployeeResource _model = new()
    {
        Id = Guid.NewGuid()
    };

    [Inject]
    public required TenantContextAccessor TenantContextAccessor { get; set; }

    [Inject]
    public required StructurHttpClient<EmployeeResource> EmployeesHttpClient { get; set; }

    [Inject]
    public INotificationBroker NotificationBroker { get; set; } = null!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = null!;

    private async Task OnValidSubmitAsync()
    {
        try
        {
            PostRequest<EmployeeResource> request = new()
            {
                TenantId = TenantContextAccessor.SelectedTenantId,
                Resource = _model
            };
            
            Result<PostResponse> result = await EmployeesHttpClient.PostAsync(request);

            result.Match(
                postResponse =>
                {
                    NotificationBroker.Send("Success", "Employee create request succeeded", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Success);
                    NavigationManager.NavigateTo("employees/" + postResponse.Id);
                },
                fault =>
                {
                    Console.WriteLine($"[FAULT] CreateEmployee request returned fault: {fault}");
                    NotificationBroker.Send("API Error", "CreateEmployee request returned a fault.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
                });
        }
        catch (Exception exception)
        {
            Console.WriteLine($"[EXCEPTION] CreateEmployee request threw exception: {exception.Message}");
            NotificationBroker.Send("API Error", "CreateEmployee request threw an exception.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
        }
    }
}