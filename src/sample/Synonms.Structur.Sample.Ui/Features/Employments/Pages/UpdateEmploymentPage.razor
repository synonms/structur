@page "/employments/{id:guid}/update"

<PageTitle>Update Employment</PageTitle>

<CarbonBlazorPane Title="Update Employment">
    <EmploymentForm Model="_model" Id="Id" Metadata="_metadata" OperationType="OperationType.Update" ValidSubmitCallback="OnValidSubmitAsync"></EmploymentForm>
</CarbonBlazorPane>

@code {
    private EmploymentResource? _model;
    private ResourceMetadata? _metadata;
    
    [Inject]
    public required TenantContextAccessor TenantContextAccessor { get; set; }

    [Inject]
    public required StructurHttpClient<EmploymentResource> EmploymentsHttpClient { get; set; }

    [Inject]
    public INotificationBroker NotificationBroker { get; set; } = null!;

    [Inject]
    public NavigationManager NavigationManager { get; set; } = null!;

    [Parameter]
    public Guid Id { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Task[] tasks =
        [
            RefreshEmploymentAsync()
        ];

        await Task.WhenAll(tasks);
    }
    
    private async Task RefreshEmploymentAsync()
    {
        if (_model is null)
        {
            return;
        }
        
        try
        {
            GetByIdRequest args = new()
            {
                TenantId = TenantContextAccessor.SelectedTenantId,
                Id = Id
            };
            
            Result<ResourceDocument<EmploymentResource>> result = await EmploymentsHttpClient.GetByIdAsync(args);

            result.Match(
                document =>
                {
                    _model = document.Resource;
                    _metadata = document.Metadata;
                },
                fault =>
                {
                    Console.WriteLine($"[FAULT] GetEmployment request returned fault: {fault}");
                    NotificationBroker.Send("API Error", "GetEmployment request returned a fault.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
                });
        }
        catch (Exception exception)
        {
            Console.WriteLine($"[EXCEPTION] GetEmployment request failed: {exception.Message}");
            NotificationBroker.Send("API Error", "GetEmployment request threw an exception.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
        }
    }
    
    private async Task OnValidSubmitAsync()
    {
        if (_model is null)
        {
            return;
        }
        
        try
        {
            PutRequest<EmploymentResource> request = new()
            {
                TenantId = TenantContextAccessor.SelectedTenantId,
                Id = Id,
                Resource = _model,
                Metadata = _metadata
            };
            
            Result<PutResponse> result = await EmploymentsHttpClient.PutAsync(request);

            result.Match(
                putResponse =>
                {
                    NotificationBroker.Send("Success", "Employment update request succeeded", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Success);
                    NavigationManager.NavigateTo("employees/" + Id);
                },
                fault =>
                {
                    Console.WriteLine($"[FAULT] UpdateEmployment request returned fault: {fault}");
                    NotificationBroker.Send("API Error", "UpdateEmployment request returned a fault.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
                });
        }
        catch (Exception exception)
        {
            Console.WriteLine($"[EXCEPTION] UpdateEmployment request failed: {exception.Message}");
            NotificationBroker.Send("API Error", "UpdateEmployment request threw an exception.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
        }
    }
}